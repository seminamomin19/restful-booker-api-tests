    {
      "name": "Create a booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\npm.test(\"Response time under 1000ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));\n\nconst body = pm.response.json();\npm.test(\"Booking ID returned\", () => pm.expect(body.bookingid).to.be.a(\"number\"));\npm.test(\"Name matches request\", () => pm.expect(body.booking.firstname).to.eql(\"Jim\"));\n\npm.collectionVariables.set(\"bookingId\", body.bookingid);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstname\": \"Jim\",\n  \"lastname\": \"Brown\",\n  \"totalprice\": 111,\n  \"depositpaid\": true,\n  \"bookingdates\": { \"checkin\": \"2026-12-01\", \"checkout\": \"2026-12-05\" },\n  \"additionalneeds\": \"Breakfast\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://restful-booker.herokuapp.com/booking",
          "protocol": "https",
          "host": [
            "restful-booker",
            "herokuapp",
            "com"
          ],
          "path": [
            "booking"
          ]
        }
